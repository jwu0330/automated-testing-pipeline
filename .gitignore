# 測試報告：v0.6 起改寫進 <project>/.testing/reports/，pipeline 端只剩
#   - reports/  → 殘留的舊資料 / 備援 staging（保留 ignore 以防）
#   - .tmp-reports/ → 純遠端測試（無 local_path）的暫存報告
reports/
.tmp-reports/

# OpenAPI → Postman collection 自動轉換的暫存產物
.tmp-collections/

# write-project-config.sh 在 URL-only 模式下產的 ephemeral 設定（無 local_path）
.tmp-ephemeral/

# bootstrap.sh 自動下載的 vendored 工具（yq 等）
bin/

# 環境變數（含敏感資訊）
.env

# 專案註冊表（含機器上的絕對路徑）
projects.registry.yml

# E2E / Monkey 執行產物
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/playwright/.cache/
tests/monkey/node_modules/
tests/monkey/test-results/

# 擷取到的登入 session（含 cookies）— 任何位置都不能 commit
storage-state.json
**/storage-state.json

# UI server 的 host 端 Playwright 安裝（供路徑 A 跳視窗登入用）
ui/node_modules/
ui/.runtime/

# Claude 本機設定
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# Docker
docker-compose.override.yml
