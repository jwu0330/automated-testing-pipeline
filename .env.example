# ═══════════════════════════════════════════════════
# 自動化測試 — 環境變數設定
# ═══════════════════════════════════════════════════
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# 目標網站
TARGET_URL=https://xcity.babydodofun.com

# OWASP ZAP 設定
ZAP_API_KEY=change-me-to-random-string

# k6 壓力測試參數
K6_VUS=10
K6_DURATION=30s
