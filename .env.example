# ═══════════════════════════════════════════════════════════════
# 自動化測試流水線 — 環境變數
# ═══════════════════════════════════════════════════════════════
# 第一次使用：
#   cp .env.example .env
#   然後依實際情況修改下列值
# ═══════════════════════════════════════════════════════════════

# ─── 預設測試目標（執行 run-project.sh 時會由 testing.yml 覆寫）───
TARGET_URL=https://xcity.babydodofun.com

# ─── OWASP ZAP ───
# 內部 API Key，填入任意隨機字串即可（不需註冊）
ZAP_API_KEY=change-me-to-random-string

# ─── k6 壓力測試預設值 ───
K6_VUS=10
K6_DURATION=30s

# ─── n8n 測試總管理者 ───
# 訪問 http://localhost:${N8N_PORT} 會要求輸入以下帳密
N8N_USER=admin
N8N_PASSWORD=please-change-to-long-random-string
N8N_PORT=5678

# ─── 流水線根目錄（宿主機絕對路徑）───
# n8n 容器內與宿主機使用相同路徑，避免 Docker-outside-of-Docker 掛載問題
PIPELINE_ROOT=/mnt/e/Code/github/automated-testing-pipeline

# ─── E2E 測試登入用帳密（選填，依專案需要）───
# E2E_USERNAME=
# E2E_PASSWORD=
