# ═══════════════════════════════════════════════════════════════
# 自動化測試流水線 — 基礎設施環境變數範本
# ═══════════════════════════════════════════════════════════════
# 用法：cp .env.example .env，再依實際值修改
#
# 本檔只存放「流水線本身」的變數。
# 各客戶專案的測試變數（target_url, 帳密等）由專案自己的
# <project>/.testing/.env 提供，請見 docs/project-convention.md
# ═══════════════════════════════════════════════════════════════

# ─── 預設測試目標（run-project.sh 會依 testing.yml 覆寫；仍需給 compose 直接啟動時一個值）───
# 請改成你自己專案的 URL；若只透過 scripts/run-project.sh 呼叫，這個值不會被用到。
TARGET_URL=https://example.com

# ─── OWASP ZAP 內部 API Key（隨機字串即可，不需註冊）───
ZAP_API_KEY=change-me-to-random-string

# ─── k6 壓力測試預設值 ───
K6_VUS=10
K6_DURATION=30s

# ─── n8n 測試總管理者 ───
N8N_USER=admin
N8N_PASSWORD=please-change-to-long-random-string
N8N_PORT=5678

# ─── 流水線根目錄（宿主機絕對路徑；n8n DooD 掛載用）───
PIPELINE_ROOT=/mnt/e/Code/github/automated-testing-pipeline

# ─── 失敗通知的寄件者位址（n8n workflow 的 Email Send 節點會用）───
# 收件人由 Form Trigger 的 notifyEmail 欄位填入；這裡只設 From。
# 真正的 SMTP 帳密請在 n8n GUI > Credentials > 新增 SMTP credential，
# 然後到 "Notify - Send Email" 節點綁上去。
SMTP_FROM=pipeline@example.com

# ─── 報告輪替（天數；0 或設 REPORTS_NO_ROTATE=1 會關閉）───
REPORTS_KEEP_DAYS=30
