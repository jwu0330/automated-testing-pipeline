{
  // Ctrl+Shift+B 觸發：在獨立 terminal 跑 Node 後端。
  // 比起 F5 不會進入 debugger，重啟更快。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run UI Server",
      "type": "shell",
      "command": "node",
      "args": ["ui/server.js"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
