# ═══════════════════════════════════════════════════════════════
#  .testing/.env  —  專案敏感變數（可選）
#
#  【只能這麼做】
#    cp .env.example .env，然後編輯 .env 填實際值
#    .env 不要 commit（此 kit 的 .gitignore 已排除）
#
#  什麼時候需要？
#    - tests.e2e.auth.enabled = true  → 要填測試帳密
#    - 專案自己的 API token / DB 密碼等
#
#  沒需要就不用建 .env，pipeline 會直接略過。
# ═══════════════════════════════════════════════════════════════

# ─── E2E 登入測試用（可選）───
# E2E_USERNAME=demo
# E2E_PASSWORD=demo-password

# ─── 專案自己的敏感值（可選，依需求加）───
# API_TOKEN=
# MAILER_DSN=
