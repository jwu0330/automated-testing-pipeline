# ═══════════════════════════════════════════════════════════════
#  .testing/.env  —  專案敏感變數（選填）
#
#  使用方式：
#    cp .env.example .env   →   編輯 .env 填實際值
#    .env 不要 commit（本 kit 的 .gitignore 已排除）
#
#  何時需要？
#    - 跑 api-test / auth-test（Newman）→ 填身分帳密
#    - 跑 e2e 登入測試                 → 填 E2E_*
#    - 專案自己的 API token / DB 密碼等
#
#  不需要就不用建 .env，pipeline 會跳過相關測試。
# ═══════════════════════════════════════════════════════════════


# ─── 身分（給 api-test / auth-test）──────────────────────────
#
#  設計：ADMIN 一組 + USER1..USER5 最多五組一般使用者。
#  每組帳密齊全就跑一輪完整 collection，空的那組整輪 skip。
#
#  ★ 為何用編號式（USER1/USER2/...）而非 list？
#    Newman --env-var 只吃扁平字串；編號式 shell 迴圈直接能讀。
#
#  ★ 何時需要多組？
#    - 驗「管理端 vs 使用者端」是否確實隔離（admin 能看到的頁，user 應 401/403）
#    - 驗不同註冊管道（LINE / 手機 / Email）登入後行為一致
#    - 每個 USER*_LABEL 會顯示在報告檔名，方便辨識
#
#  報告檔名：newman-junit-admin.xml / newman-junit-user1-line_signup.xml ...

# 管理者（慣例寫死 admin001 / @admin001；若該站不同才覆寫）
ADMIN_USERNAME=admin001
ADMIN_PASSWORD=@admin001

# 一般使用者 1（選填；留空 → 此身分整輪 skip）
USER1_USERNAME=
USER1_PASSWORD=
USER1_LABEL=                 # 例：line_signup

# 一般使用者 2
USER2_USERNAME=
USER2_PASSWORD=
USER2_LABEL=                 # 例：phone_signup

# 一般使用者 3
USER3_USERNAME=
USER3_PASSWORD=
USER3_LABEL=

# 一般使用者 4
USER4_USERNAME=
USER4_PASSWORD=
USER4_LABEL=

# 一般使用者 5
USER5_USERNAME=
USER5_PASSWORD=
USER5_LABEL=


# ─── E2E / Playwright 登入（向下相容，給舊 spec 用）───────
#  若登入流程跟 admin 相同，直接沿用；否則客製。
E2E_USERNAME=admin001
E2E_PASSWORD=@admin001


# ─── 專案自己的敏感值（依需求新增）────────────────────────
# API_TOKEN=
# MAILER_DSN=
# DB_PASSWORD=
