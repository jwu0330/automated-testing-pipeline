<?php
/**
 * PHPUnit bootstrap 範本 — 公版
 *
 * 本檔案是流水線提供的「範本」，不會直接執行。
 * 各專案複製到 <project>/.testing/unit/bootstrap.php 並調整。
 *
 * 用途：
 *   - 在跑測試前載入專案要被測的程式碼
 *   - 若有 DB 整合測試：連到 pipeline 提供的 test-mysql 容器
 *   - 注入 stub / mock，讓純函式可被獨立測試
 *
 * ───────────────────────────────────────────────────────────────
 * DB 整合測試（pipeline option B）
 *
 * 當專案在 .testing/unit/fixtures/ 有 *.sql，或 testing.yml 設定
 * tests.unit.use_db: true 時，pipeline 會自動啟動 test-mysql 容器、
 * 載入 database/init.sql + fixtures，然後透過環境變數把連線資訊
 * 傳進 PHPUnit 容器：
 *
 *     TEST_DB_HOST=test-mysql
 *     TEST_DB_PORT=3306
 *     TEST_DB_NAME=test
 *     TEST_DB_USER=root
 *     TEST_DB_PASSWORD=test
 *
 * 這些 env 只在測試跑時存在。production 程式碼不會看到，也不能
 * 讓 production 程式碼的 db() 函式連到這裡（否則就失去隔離意義）。
 * ───────────────────────────────────────────────────────────────
 */

// ── 範例 A：composer 專案 ──
// require_once __DIR__ . '/../../vendor/autoload.php';

// ── 範例 B：老式 require 專案 ──
// require_once __DIR__ . '/stubs.php';
// require_once __DIR__ . '/../../public/api/YOUR_HELPERS.php';

// ── 範例 C：DB 整合測試 helper ──
// 測試類別可用 testDb() 取得 PDO 連線：
if (getenv('TEST_DB_HOST')) {
    if (!function_exists('testDb')) {
        /**
         * @return \PDO 連到 test-mysql 的 PDO，已載入 schema + fixtures
         */
        function testDb(): \PDO {
            static $pdo = null;
            if ($pdo !== null) return $pdo;
            $dsn = sprintf(
                'mysql:host=%s;port=%s;dbname=%s;charset=utf8mb4',
                getenv('TEST_DB_HOST'),
                getenv('TEST_DB_PORT') ?: '3306',
                getenv('TEST_DB_NAME') ?: 'test'
            );
            $pdo = new \PDO($dsn, getenv('TEST_DB_USER') ?: 'root', getenv('TEST_DB_PASSWORD') ?: '', [
                \PDO::ATTR_ERRMODE => \PDO::ERRMODE_EXCEPTION,
                \PDO::ATTR_DEFAULT_FETCH_MODE => \PDO::FETCH_ASSOC,
            ]);
            return $pdo;
        }
    }
}
