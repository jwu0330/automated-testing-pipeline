{
  "id": "1FEmJA01Yi8SJWYZ",
  "name": "Manual SSL Test",
  "nodes": [
    {
      "parameters": {
        "formTitle": "SSL Test — Run Project",
        "formDescription": "輸入已註冊的專案名稱，立即跑 SSL/TLS 檢測。",
        "formFields": {
          "values": [
            {
              "fieldLabel": "projectName",
              "placeholder": "例：your-project（必須已在 projects.registry.yml 註冊）",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a0a0-0000-0000-0000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "=bash scripts/run-project.sh {{ $('Manual Trigger').first().json.projectName }} ssl"
      },
      "id": "b1a1a0a0-0000-0000-0000-000000000002",
      "name": "Run SSL Test",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300],
      "notes": "呼叫 pipeline 的 SSL 測試。\ncwd 已由容器 working_dir 指向 PIPELINE_ROOT，\n所以用相對路徑即可。"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1-exit",
              "name": "exitCode",
              "value": "={{ $json.exitCode }}",
              "type": "number"
            },
            {
              "id": "f2-status",
              "name": "status",
              "value": "={{ $json.exitCode === 0 ? '✅ PASS' : '❌ FAIL' }}",
              "type": "string"
            },
            {
              "id": "f3-stdout",
              "name": "stdout_tail",
              "value": "={{ $json.stdout.split('\\n').slice(-30).join('\\n') }}",
              "type": "string"
            },
            {
              "id": "f4-stderr",
              "name": "stderr",
              "value": "={{ $json.stderr }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a1a0a0-0000-0000-0000-000000000003",
      "name": "Format Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300],
      "notes": "把 exitCode 轉成易讀狀態，\n只保留 stdout 最後 30 行以免刷屏。"
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Run SSL Test", "type": "main", "index": 0 }]]
    },
    "Run SSL Test": {
      "main": [[{ "node": "Format Result", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "0.1.0",
  "triggerCount": 0,
  "tags": [
    { "name": "pipeline" },
    { "name": "ssl" }
  ]
}
